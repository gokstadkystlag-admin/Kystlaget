---
import Layout from "../../layouts/Layout.astro";
import KontaktLag from "../../components/KontaktLag.astro";
import { getEntry } from "astro:content";
import { avsnitt } from "../../lib/tekst";

const side = (await getEntry("sider", "lag-kystledlaget"))!.data;
---

<Layout tittel={side.tittel} beskrivelse="Kystledlaget driver rimelige overnattingshytter langs kysten, på Gokstadholmen og Buerøya. Her ser du hyttene og hvordan du booker.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <a href="/lag" class="text-kyst-lys-blaa text-sm hover:underline">&larr; Alle arbeidslag</a>
    <h1 class="text-3xl font-heading font-bold mt-4 mb-6">{side.tittel}</h1>
    <img src={side.bilde} alt={side.tittel} class="w-full h-64 object-cover rounded-lg mb-8" />

    <div class="text-kyst-graa space-y-4 mb-10">
      {avsnitt(side.intro).map((p) => <p>{p}</p>)}
    </div>

    <h2 class="text-xl font-heading font-bold mb-4">{side.hytter_tittel}</h2>
    <div class="space-y-4 mb-10">
      {side.hytter.map((h: { navn: string; tekst: string }) => (
        <div class="bg-white rounded-lg shadow p-6">
          <h3 class="font-heading font-bold text-lg mb-1">{h.navn}</h3>
          <p class="text-kyst-graa text-sm">
            {h.tekst}
          </p>
        </div>
      ))}
    </div>

    <div class="bg-kyst-blaa/10 rounded-lg p-6">
      <h3 class="font-heading font-bold mb-2">{side.booking_tittel}</h3>
      <p class="text-kyst-graa text-sm">
        {side.booking_tekst}
      </p>
    </div>
    <KontaktLag lag={side.tittel} />
  </div>
</Layout>
