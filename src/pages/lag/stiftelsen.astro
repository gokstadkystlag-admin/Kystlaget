---
import Layout from "../../layouts/Layout.astro";
import KontaktLag from "../../components/KontaktLag.astro";
import { getEntry } from "astro:content";
import { avsnitt, mdInline } from "../../lib/tekst";

const side = (await getEntry("sider", "lag-stiftelsen"))!.data;
---

<Layout tittel={side.tittel} beskrivelse="Stiftelsen Sandefjord Kystkultursenter er et samarbeid mellom kommunen, AJHS og Gokstad Kystlag, og forvalter eiendommene.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <a href="/lag" class="text-kyst-lys-blaa text-sm hover:underline">&larr; Alle arbeidslag</a>
    <h1 class="text-3xl font-heading font-bold mt-4 mb-6">{side.tittel}</h1>
    <img src={side.bilde} alt={side.tittel} class="w-full h-64 object-cover rounded-lg mb-8" />

    <div class="text-kyst-graa space-y-4 mb-10">
      {avsnitt(side.intro).map((p) => <p>{p}</p>)}
    </div>

    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="font-heading font-bold text-lg mb-3">{side.eiendommer_tittel}</h2>
      <ul class="text-kyst-graa text-sm space-y-2 list-disc list-inside">
        {side.eiendommer.map((e: string) => <li>{e}</li>)}
      </ul>
    </div>

    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="font-heading font-bold text-lg mb-3">{side.prosjekter_tittel}</h2>
      <ul class="text-kyst-graa text-sm space-y-2 list-disc list-inside">
        {side.prosjekter.map((p: string) => <li set:html={mdInline(p)} />)}
      </ul>
    </div>
    <KontaktLag lag={side.tittel} />
  </div>
</Layout>
