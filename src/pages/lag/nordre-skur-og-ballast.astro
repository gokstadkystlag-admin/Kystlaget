---
import Layout from "../../layouts/Layout.astro";
import KontaktLag from "../../components/KontaktLag.astro";
import { getEntry } from "astro:content";
import { mdInline } from "../../lib/tekst";

const side = (await getEntry("sider", "lag-nordre-skur-og-ballast"))!.data;
---

<Layout tittel={side.tittel} beskrivelse="Nordre Skur og Ballast er koret i Gokstad Kystlag, med 33 sangere og 7 musikere. Koret har gitt ut fire studioalbum.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <a href="/lag" class="text-kyst-lys-blaa text-sm hover:underline">&larr; Alle arbeidslag</a>
    <h1 class="text-3xl font-heading font-bold mt-4 mb-6">{side.tittel}</h1>
    <img src={side.bilde} alt={side.tittel} class="w-full h-64 object-cover rounded-lg mb-8" />

    <div class="text-kyst-graa space-y-4 mb-10">
      <p>
        {side.intro}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mb-10">
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="font-heading font-bold text-lg mb-3">{side.besetning_tittel}</h2>
        <ul class="text-kyst-graa text-sm space-y-1">
          {side.besetning.map((b: string) => <li set:html={mdInline(b)} />)}
        </ul>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="font-heading font-bold text-lg mb-3">{side.repertoar_tittel}</h2>
        <ul class="text-kyst-graa text-sm space-y-1 list-disc list-inside">
          {side.repertoar.map((r: string) => <li>{r}</li>)}
        </ul>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="font-heading font-bold text-lg mb-3">{side.ovelser_tittel}</h2>
      <p class="text-kyst-graa text-sm">{side.ovelser_tekst}</p>
    </div>

    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="font-heading font-bold text-lg mb-3">{side.studioalbum_tittel}</h2>
      <ol class="text-kyst-graa text-sm space-y-1 list-decimal list-inside">
        {side.studioalbum.map((s: string) => <li>{s}</li>)}
      </ol>
    </div>

    <div class="bg-kyst-blaa/10 rounded-lg p-6">
      <p class="text-kyst-graa text-sm">
        {side.notat}
      </p>
    </div>
    <KontaktLag lag={side.tittel} />
  </div>
</Layout>
