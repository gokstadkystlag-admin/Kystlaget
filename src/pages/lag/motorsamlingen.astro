---
import Layout from "../../layouts/Layout.astro";
import KontaktLag from "../../components/KontaktLag.astro";
import { getEntry } from "astro:content";
import { mdInline } from "../../lib/tekst";

const side = (await getEntry("sider", "lag-motorsamlingen"))!.data;
---

<Layout tittel={side.tittel} beskrivelse="Motorsamlingen er et museum med rundt 130 båtmotorer og 1 000 dokumenter hos Gokstad Kystlag i Sandefjord. Museet åpnet i 1995.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <a href="/lag" class="text-kyst-lys-blaa text-sm hover:underline">&larr; Alle arbeidslag</a>
    <h1 class="text-3xl font-heading font-bold mt-4 mb-6">{side.tittel}</h1>
    <img src={side.bilde} alt={side.tittel} class="w-full h-64 object-cover rounded-lg mb-8" />

    <div class="text-kyst-graa space-y-4 mb-10">
      <p>
        {side.intro}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mb-10">
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="font-heading font-bold text-lg mb-3">{side.museet_tittel}</h2>
        <ul class="text-kyst-graa text-sm space-y-1">
          {side.museet.map((m: string) => <li set:html={mdInline(m)} />)}
        </ul>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="font-heading font-bold text-lg mb-3">{side.motortyper_tittel}</h2>
        <ul class="text-kyst-graa text-sm space-y-1 list-disc list-inside">
          {side.motortyper.map((m: string) => <li>{m}</li>)}
        </ul>
      </div>
    </div>
    <KontaktLag lag={side.tittel} />
  </div>
</Layout>
