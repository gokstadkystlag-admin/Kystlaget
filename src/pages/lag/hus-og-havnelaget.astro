---
import Layout from "../../layouts/Layout.astro";
import KontaktLag from "../../components/KontaktLag.astro";
import { getEntry } from "astro:content";

const side = (await getEntry("sider", "lag-hus-og-havnelaget"))!.data;
---

<Layout tittel={side.tittel}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <a href="/lag" class="text-kyst-lys-blaa text-sm hover:underline">&larr; Alle arbeidslag</a>
    <h1 class="text-3xl font-heading font-bold mt-4 mb-6">{side.tittel}</h1>
    <img src={side.bilde} alt={side.tittel} class="w-full h-64 object-cover rounded-lg mb-8" />

    <div class="text-kyst-graa space-y-4 mb-10">
      <p>
        {side.intro}
      </p>
    </div>

    <div class="space-y-6 mb-10">
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="font-heading font-bold text-lg mb-2">{side.boks1.tittel}</h2>
        <p class="text-kyst-graa text-sm">
          {side.boks1.tekst}
        </p>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="font-heading font-bold text-lg mb-2">{side.boks2.tittel}</h2>
        <p class="text-kyst-graa text-sm">
          {side.boks2.tekst}
        </p>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="font-heading font-bold text-lg mb-2">{side.boks3.tittel}</h2>
        <p class="text-kyst-graa text-sm">
          {side.boks3.tekst}
        </p>
      </div>
    </div>
    <KontaktLag lag={side.tittel} />
  </div>
</Layout>
