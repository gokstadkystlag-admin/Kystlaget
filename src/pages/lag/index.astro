---
import Layout from "../../layouts/Layout.astro";
import { getEntry } from "astro:content";

// Rekkefølgen på arbeidslagene i oversikten er en del av sidedesignet og er derfor
// fast her — selve navn/tekst/bilde for hvert lag hentes fra lagets egen CMS-fil.
const lag_slugs = [
  "fartoy-og-kulturlaget",
  "hus-og-havnelaget",
  "infolaget",
  "verkstedlaget",
  "kystledlaget",
  "gokstadveverne",
  "modellbatlaget",
  "nordre-skur-og-ballast",
  "gk-ung",
  "motorsamlingen",
  "stiftelsen",
];

const side = (await getEntry("sider", "lag-oversikt"))!.data;
const lag = await Promise.all(
  lag_slugs.map(async (slug) => {
    const entry = (await getEntry("sider", `lag-${slug}`))!.data;
    return { id: slug, navn: entry.tittel, kort: entry.kort_beskrivelse, bilde: entry.bilde };
  })
);
---

<Layout tittel="Arbeidslagene" beskrivelse="Gokstad Kystlag har 11 arbeidslag, med båtbygging, veving, kor, seiling, motormuseum og mye mer. Alle medlemmer kan være med.">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-heading font-bold mb-4">{side.tittel}</h1>
    <p class="text-kyst-graa mb-8">
      {side.intro}
    </p>

    <div class="grid md:grid-cols-2 gap-6">
      {lag.map((l) => (
        <a href={`/lag/${l.id}`} class="bg-white rounded-lg shadow overflow-hidden hover:shadow-md transition group">
          <img src={l.bilde} alt={l.navn} class="w-full h-48 object-cover" />
          <div class="p-5">
            <h2 class="text-lg font-heading font-bold text-kyst-blaa group-hover:text-kyst-lys-blaa transition-colors">{l.navn}</h2>
            <p class="text-kyst-graa mt-2 text-sm">{l.kort}</p>
            <span class="text-kyst-blaa text-sm mt-3 inline-block group-hover:underline">Les mer &rarr;</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-10 bg-kyst-blaa/10 rounded-lg p-8 text-center">
      <h3 class="font-heading font-bold text-lg mb-2">{side.cta.tittel}</h3>
      <p class="text-kyst-graa mb-4">
        {side.cta.tekst}
      </p>
      <a href="/kontakt" class="bg-kyst-blaa text-white px-6 py-3 rounded-md font-bold hover:bg-kyst-lys-blaa transition-colors inline-block">
        {side.cta.knapp_tekst}
      </a>
    </div>
  </div>
</Layout>
