---
import Layout from "../../layouts/Layout.astro";
import KontaktLag from "../../components/KontaktLag.astro";
import { getEntry } from "astro:content";
import { mdInline } from "../../lib/tekst";

const side = (await getEntry("sider", "lag-gk-ung"))!.data;
---

<Layout tittel={side.tittel} beskrivelse="GK Ung er ungdomsgruppen i Gokstad Kystlag, med seiling i Meginjoller og Colin Archer-skøyten Vega.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <a href="/lag" class="text-kyst-lys-blaa text-sm hover:underline">&larr; Alle arbeidslag</a>
    <h1 class="text-3xl font-heading font-bold mt-4 mb-6">{side.tittel}</h1>
    <img src={side.bilde} alt={side.tittel} class="w-full h-64 object-cover rounded-lg mb-8" />

    <div class="text-kyst-graa space-y-4 mb-10">
      <p>
        {side.sitat}
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mb-10">
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="font-heading font-bold text-lg mb-3">{side.baater_tittel}</h2>
        <ul class="text-kyst-graa text-sm space-y-1 list-disc list-inside">
          {side.baater.map((b: string) => <li set:html={mdInline(b)} />)}
        </ul>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="font-heading font-bold text-lg mb-3">{side.aktiviteter_tittel}</h2>
        <ul class="text-kyst-graa text-sm space-y-1 list-disc list-inside">
          {side.aktiviteter.map((a: string) => <li>{a}</li>)}
        </ul>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="font-heading font-bold text-lg mb-3">{side.skoler_tittel}</h2>
      <p class="text-kyst-graa text-sm mb-2">{side.skoler_intro}</p>
      <ul class="text-kyst-graa text-sm space-y-1 list-disc list-inside">
        {side.skoler.map((s: string) => <li set:html={mdInline(s)} />)}
      </ul>
      <p class="text-kyst-graa text-sm mt-2">
        {side.skoler_outro}
      </p>
    </div>

    <div class="bg-kyst-gul/20 rounded-lg p-6">
      <h3 class="font-heading font-bold mb-2">{side.teambuilding_tittel}</h3>
      <p class="text-kyst-graa text-sm">
        {side.teambuilding_tekst}
        <a href={`mailto:post@gokstadkystlag.no?subject=${encodeURIComponent('Jeg vil gjerne høre mer om teambuilding med ' + side.tittel)}`} class="text-kyst-blaa hover:underline">Ta kontakt</a> for å høre mer.
      </p>
    </div>
    <KontaktLag lag={side.tittel} />
  </div>
</Layout>
