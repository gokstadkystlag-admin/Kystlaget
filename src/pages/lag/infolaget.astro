---
import Layout from "../../layouts/Layout.astro";
import KontaktLag from "../../components/KontaktLag.astro";
import { getEntry } from "astro:content";

const side = (await getEntry("sider", "lag-infolaget"))!.data;
---

<Layout tittel={side.tittel}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <a href="/lag" class="text-kyst-lys-blaa text-sm hover:underline">&larr; Alle arbeidslag</a>
    <h1 class="text-3xl font-heading font-bold mt-4 mb-6">{side.tittel}</h1>
    <img src={side.bilde} alt={side.bilde_alt} class="w-full h-64 object-cover rounded-lg mb-8" />

    <div class="text-kyst-graa space-y-4 mb-10">
      <p>
        {side.intro}
      </p>
    </div>

    <div class="bg-white rounded-lg shadow p-6 mb-6">
      <h2 class="font-heading font-bold text-lg mb-3">{side.oppgaver_tittel}</h2>
      <ul class="text-kyst-graa text-sm space-y-2 list-disc list-inside">
        {side.oppgaver.map((o: string) => <li>{o}</li>)}
      </ul>
    </div>
    <KontaktLag lag={side.tittel} />
  </div>
</Layout>
