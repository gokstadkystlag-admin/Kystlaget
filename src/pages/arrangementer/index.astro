---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const alle = (await getCollection("arrangementer"))
  .sort((a, b) => a.data.dato.getTime() - b.data.dato.getTime());

const kommende = alle.filter((a) => a.data.dato >= new Date());
const tidligere = alle.filter((a) => a.data.dato < new Date()).reverse();
---

<Layout tittel="Arrangementer" beskrivelse="Arrangementer hos Gokstad Kystlag i Sandefjord — kurs, dugnader, fester og kystkulturarrangementer.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-heading font-bold mb-8">Arrangementer</h1>

    <section class="mb-12">
      <h2 class="text-xl font-heading font-bold mb-4">Kommende</h2>
      {kommende.length > 0 ? (
        <div class="space-y-4">
          {kommende.map((arr) => (
            <a href={`/arrangementer/${arr.id}`} class="block bg-white rounded-lg shadow p-6 hover:shadow-md transition">
              <div class="flex justify-between items-start">
                <div>
                  <h3 class="text-lg font-semibold">{arr.data.tittel}</h3>
                  <p class="text-sm text-gray-600 mt-1">{arr.data.beskrivelse}</p>
                </div>
                <time class="text-sm text-kyst-lys-blaa font-medium whitespace-nowrap ml-4">
                  {arr.data.dato.toLocaleDateString("nb-NO", { day: "numeric", month: "long" })}
                </time>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-gray-600">Ingen kommende arrangementer akkurat nå.</p>
      )}
    </section>

    {tidligere.length > 0 && (
      <section>
        <h2 class="text-xl font-heading font-bold mb-4 text-gray-500">Tidligere</h2>
        <div class="space-y-4 opacity-70">
          {tidligere.map((arr) => (
            <a href={`/arrangementer/${arr.id}`} class="block bg-white rounded-lg shadow p-4">
              <h3 class="font-semibold">{arr.data.tittel}</h3>
              <time class="text-sm text-gray-500">
                {arr.data.dato.toLocaleDateString("nb-NO", { day: "numeric", month: "long", year: "numeric" })}
              </time>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
