---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";
import { mdInline } from "../lib/tekst";

const side = (await getEntry("sider", "utleie"))!.data;
---

<Layout tittel="Selskapslokaler i Sandefjord" beskrivelse="Lei selskapslokaler med havneutsikt i Sandefjord. Plass til 60 personer, fullt kjøkken og brygge. Passer til bryllup, bursdag og firmafest.">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-heading font-bold mb-4">{side.tittel}</h1>
    <p class="text-kyst-graa mb-8">
      {side.intro}
    </p>

    <!-- Bildegalleri -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-10" data-galleri>
      {side.bilder.map((b: { bilde: string; alt: string; bildetekst?: string }, i: number) => (
        <button type="button" data-bilde={i} data-tekst={b.bildetekst ?? ""} aria-label={`Åpne bilde: ${b.alt}`}
          class="block overflow-hidden rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-kyst-blaa">
          <img src={b.bilde} alt={b.alt} loading="lazy" class="w-full h-48 md:h-56 object-cover hover:opacity-90 transition-opacity" />
        </button>
      ))}
    </div>

    <dialog id="galleri-dialog" aria-label="Bildegalleri" class="bg-transparent p-0 m-0 max-w-none max-h-none w-full h-full backdrop:bg-black/90">
      <div class="w-full h-full flex flex-col items-center justify-center p-4 select-none" data-lukk>
        <figure class="max-w-5xl w-full flex flex-col items-center">
          <img id="galleri-bilde" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded" />
          <figcaption id="galleri-tekst" class="text-white text-sm mt-3 text-center"></figcaption>
        </figure>
        <p id="galleri-teller" class="text-gray-300 text-xs mt-2"></p>
      </div>
      <button type="button" id="galleri-lukk" aria-label="Lukk" class="absolute top-4 right-4 text-white text-3xl leading-none w-11 h-11 rounded-full bg-black/50 hover:bg-black/70">&times;</button>
      <button type="button" id="galleri-forrige" aria-label="Forrige bilde" class="absolute left-2 md:left-6 top-1/2 -translate-y-1/2 text-white text-3xl leading-none w-11 h-11 rounded-full bg-black/50 hover:bg-black/70">&#8249;</button>
      <button type="button" id="galleri-neste" aria-label="Neste bilde" class="absolute right-2 md:right-6 top-1/2 -translate-y-1/2 text-white text-3xl leading-none w-11 h-11 rounded-full bg-black/50 hover:bg-black/70">&#8250;</button>
    </dialog>


    <div class="grid md:grid-cols-2 gap-6 mb-10">
      <!-- Andre etasje -->
      <div class="bg-white rounded-lg shadow p-8">
        <h2 class="text-xl font-heading font-bold mb-2">{side.andre_etasje.tittel}</h2>
        <p class="text-kyst-blaa text-sm font-medium mb-4">{side.andre_etasje.undertittel}</p>
        <ul class="text-kyst-graa text-sm space-y-2">
          {side.andre_etasje.liste.map((p: string) => <li>&#10003; {p}</li>)}
        </ul>
      </div>

      <!-- Første etasje -->
      <div class="bg-white rounded-lg shadow p-8">
        <h2 class="text-xl font-heading font-bold mb-2">{side.forste_etasje.tittel}</h2>
        <p class="text-kyst-blaa text-sm font-medium mb-4">{side.forste_etasje.undertittel}</p>
        <ul class="text-kyst-graa text-sm space-y-2">
          {side.forste_etasje.liste.map((p: string) => <li>&#10003; {p}</li>)}
        </ul>
      </div>
    </div>

    <!-- Praktisk info -->
    <div class="bg-white rounded-lg shadow p-8 mb-10">
      <h2 class="text-xl font-heading font-bold mb-4">{side.praktisk.tittel}</h2>
      <div class="grid md:grid-cols-2 gap-6 text-sm text-kyst-graa">
        <div>
          <h3 class="font-semibold text-kyst-mork mb-2">{side.praktisk.leietid.tittel}</h3>
          <ul class="space-y-1">
            {side.praktisk.leietid.liste.map((p: string) => <li set:html={mdInline(p)} />)}
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-kyst-mork mb-2">{side.praktisk.nokler.tittel}</h3>
          <ul class="space-y-1">
            {side.praktisk.nokler.liste.map((p: string) => <li>{p}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-kyst-mork mb-2">{side.praktisk.renhold.tittel}</h3>
          <ul class="space-y-1">
            {side.praktisk.renhold.liste.map((p: string) => <li>{p}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-kyst-mork mb-2">{side.praktisk.regler.tittel}</h3>
          <ul class="space-y-1">
            {side.praktisk.regler.liste.map((p: string) => <li>{p}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <!-- Booking CTA -->
    <div class="bg-kyst-blaa text-white rounded-lg p-8">
      <div class="md:flex md:items-center md:justify-between">
        <div class="mb-6 md:mb-0">
          <h2 class="text-xl font-heading font-bold mb-2">{side.booking.tittel}</h2>
          <p class="text-gray-200 text-sm">
            {side.booking.tekst}
          </p>
          <p class="text-gray-300 text-sm mt-2">
            Telefon: <a href={`tel:${side.booking.telefon.replace(/\s/g, "")}`} class="text-kyst-gul hover:underline">{side.booking.telefon}</a> ({side.booking.telefon_tid})
          </p>
        </div>
        <a href="https://www.utleie.gokstadkystlag.no/wpbc-booking/" target="_blank" rel="noopener"
          class="bg-kyst-gul text-kyst-mork px-6 py-3 rounded-md font-bold hover:bg-amber-400 transition-colors inline-block whitespace-nowrap">
          {side.booking.knapp_tekst}
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  const dialog = document.getElementById("galleri-dialog") as HTMLDialogElement | null;
  const knapper = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-bilde]"));

  if (dialog && knapper.length) {
    const bilde = document.getElementById("galleri-bilde") as HTMLImageElement;
    const tekst = document.getElementById("galleri-tekst")!;
    const teller = document.getElementById("galleri-teller")!;
    const forrige = document.getElementById("galleri-forrige")!;
    const neste = document.getElementById("galleri-neste")!;
    let nå = 0;

    const vis = (i: number) => {
      nå = (i + knapper.length) % knapper.length;
      const img = knapper[nå].querySelector("img")!;
      bilde.src = img.currentSrc || img.src;
      bilde.alt = img.alt;
      tekst.textContent = knapper[nå].dataset.tekst ?? "";
      teller.textContent = `Bilde ${nå + 1} av ${knapper.length}`;
      const flere = knapper.length > 1;
      forrige.hidden = !flere;
      neste.hidden = !flere;
    };

    knapper.forEach((k, i) => k.addEventListener("click", () => { vis(i); dialog.showModal(); }));
    document.getElementById("galleri-lukk")!.addEventListener("click", () => dialog.close());
    forrige.addEventListener("click", () => vis(nå - 1));
    neste.addEventListener("click", () => vis(nå + 1));

    // Trykk utenfor bildet lukker
    dialog.addEventListener("click", (e) => {
      const mål = e.target as HTMLElement;
      if (mål === dialog || mål.hasAttribute("data-lukk")) dialog.close();
    });

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") vis(nå - 1);
      if (e.key === "ArrowRight") vis(nå + 1);
    });

    // Sveip på telefon
    let startX = 0;
    dialog.addEventListener("touchstart", (e) => { startX = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) vis(dx < 0 ? nå + 1 : nå - 1);
    });
  }
</script>
