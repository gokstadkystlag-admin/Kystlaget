---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";
import { mdInline } from "../lib/tekst";

const side = (await getEntry("sider", "utleie"))!.data;
---

<Layout tittel="Selskapslokaler" beskrivelse="Lei selskapslokaler med havneutsikt i Sandefjord. Plass til 60 personer, fullt kjøkken, brygge. Bryllup, bursdag og firmafest.">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-heading font-bold mb-4">{side.tittel}</h1>
    <p class="text-kyst-graa mb-8">
      {side.intro}
    </p>

    <!-- Bildegalleri -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mb-10">
      <img src={side.bilder.bilde1} alt="Selskapslokale" loading="lazy" class="w-full h-48 object-cover rounded-lg col-span-2 md:col-span-1 md:h-56" />
      <img src={side.bilder.bilde2} alt="Selskapslokale dekor" loading="lazy" class="w-full h-48 object-cover rounded-lg md:h-56" />
      <img src={side.bilder.bilde3} alt="Selskapslokale brygge" loading="lazy" class="w-full h-48 object-cover rounded-lg md:h-56" />
      <img src={side.bilder.bilde4} alt="Selskapslokale kjøkken" loading="lazy" class="w-full h-48 object-cover rounded-lg md:h-56" />
      <img src={side.bilder.bilde5} alt="Selskapslokale utsikt" loading="lazy" class="w-full h-48 object-cover rounded-lg col-span-2 md:col-span-2 md:h-56" />
    </div>

    <div class="grid md:grid-cols-2 gap-6 mb-10">
      <!-- Andre etasje -->
      <div class="bg-white rounded-lg shadow p-8">
        <h2 class="text-xl font-heading font-bold mb-2">{side.andre_etasje.tittel}</h2>
        <p class="text-kyst-blaa text-sm font-medium mb-4">{side.andre_etasje.undertittel}</p>
        <ul class="text-kyst-graa text-sm space-y-2">
          {side.andre_etasje.liste.map((p: string) => <li>&#10003; {p}</li>)}
        </ul>
      </div>

      <!-- Første etasje -->
      <div class="bg-white rounded-lg shadow p-8">
        <h2 class="text-xl font-heading font-bold mb-2">{side.forste_etasje.tittel}</h2>
        <p class="text-kyst-blaa text-sm font-medium mb-4">{side.forste_etasje.undertittel}</p>
        <ul class="text-kyst-graa text-sm space-y-2">
          {side.forste_etasje.liste.map((p: string) => <li>&#10003; {p}</li>)}
        </ul>
      </div>
    </div>

    <!-- Praktisk info -->
    <div class="bg-white rounded-lg shadow p-8 mb-10">
      <h2 class="text-xl font-heading font-bold mb-4">{side.praktisk.tittel}</h2>
      <div class="grid md:grid-cols-2 gap-6 text-sm text-kyst-graa">
        <div>
          <h3 class="font-semibold text-kyst-mork mb-2">{side.praktisk.leietid.tittel}</h3>
          <ul class="space-y-1">
            {side.praktisk.leietid.liste.map((p: string) => <li set:html={mdInline(p)} />)}
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-kyst-mork mb-2">{side.praktisk.nokler.tittel}</h3>
          <ul class="space-y-1">
            {side.praktisk.nokler.liste.map((p: string) => <li>{p}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-kyst-mork mb-2">{side.praktisk.renhold.tittel}</h3>
          <ul class="space-y-1">
            {side.praktisk.renhold.liste.map((p: string) => <li>{p}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="font-semibold text-kyst-mork mb-2">{side.praktisk.regler.tittel}</h3>
          <ul class="space-y-1">
            {side.praktisk.regler.liste.map((p: string) => <li>{p}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <!-- Booking CTA -->
    <div class="bg-kyst-blaa text-white rounded-lg p-8">
      <div class="md:flex md:items-center md:justify-between">
        <div class="mb-6 md:mb-0">
          <h2 class="text-xl font-heading font-bold mb-2">{side.booking.tittel}</h2>
          <p class="text-gray-200 text-sm">
            {side.booking.tekst}
          </p>
          <p class="text-gray-300 text-sm mt-2">
            Telefon: <a href={`tel:${side.booking.telefon.replace(/\s/g, "")}`} class="text-kyst-gul hover:underline">{side.booking.telefon}</a> ({side.booking.telefon_tid})
          </p>
        </div>
        <a href="https://www.utleie.gokstadkystlag.no/wpbc-booking/" target="_blank" rel="noopener"
          class="bg-kyst-gul text-kyst-mork px-6 py-3 rounded-md font-bold hover:bg-amber-400 transition-colors inline-block whitespace-nowrap">
          {side.booking.knapp_tekst}
        </a>
      </div>
    </div>
  </div>
</Layout>
