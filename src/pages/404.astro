---
import Layout from "../layouts/Layout.astro";
---

<Layout tittel="Siden finnes ikke">
  <div class="max-w-2xl mx-auto px-4 py-20 text-center">
    <p class="text-6xl font-heading font-bold text-kyst-lys-blaa mb-4">404</p>
    <h1 class="text-2xl font-heading font-bold mb-4">Siden finnes ikke</h1>
    <p class="text-kyst-graa mb-8">Beklager, vi finner ikke siden du leter etter.</p>
    <div class="flex gap-4 justify-center flex-wrap">
      <a href="/" class="bg-kyst-blaa text-white px-6 py-3 rounded-md font-bold hover:bg-kyst-lys-blaa transition-colors text-sm uppercase tracking-wide">
        Til forsiden
      </a>
      <a href="/kontakt" class="border-2 border-kyst-blaa text-kyst-blaa px-6 py-3 rounded-md font-semibold hover:bg-kyst-blaa hover:text-white transition-colors text-sm uppercase tracking-wide">
        Kontakt oss
      </a>
    </div>
  </div>
</Layout>
