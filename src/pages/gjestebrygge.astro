---
import Layout from "../layouts/Layout.astro";
---

<Layout tittel="Gjestebrygge">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-heading font-bold mb-4">Gjestebrygge</h1>
    <p class="text-kyst-graa mb-8">
      Gokstad Kystlag har gjestebrygge ved indre havn i Sandefjord.
      Velkommen innom om du kommer sjøveien!
    </p>

    <img src="/images/gjestebrygge.webp" alt="Gjestebryggen ved Gokstad Kystlag" class="w-full h-64 object-cover rounded-lg mb-10" />

    <div class="grid md:grid-cols-2 gap-6 mb-10">
      <!-- Priser -->
      <div class="bg-white rounded-lg shadow p-8">
        <h2 class="text-xl font-heading font-bold mb-4">Priser</h2>
        <div class="space-y-4">
          <div class="flex justify-between items-center border-b pb-3">
            <div>
              <p class="font-semibold">Medlemmer</p>
              <p class="text-kyst-graa text-sm">Kystlag tilknyttet Forbundet Kysten</p>
            </div>
            <p class="text-2xl font-bold text-kyst-blaa">150 kr</p>
          </div>
          <div class="flex justify-between items-center">
            <div>
              <p class="font-semibold">Ikke-medlemmer</p>
              <p class="text-kyst-graa text-sm">Andre gjester</p>
            </div>
            <p class="text-2xl font-bold text-kyst-blaa">350 kr</p>
          </div>
        </div>
        <p class="text-kyst-graa text-sm mt-4">Per døgn: kl. 16:00 – kl. 12:00 neste dag</p>
      </div>

      <!-- Betaling -->
      <div class="bg-white rounded-lg shadow p-8">
        <h2 class="text-xl font-heading font-bold mb-4">Betaling med Vipps</h2>
        <div class="text-kyst-graa text-sm space-y-3">
          <div>
            <p class="font-semibold text-kyst-mork">Vipps-nummer</p>
            <p class="text-2xl font-bold text-kyst-blaa">80567</p>
            <p>Gokstad Kystlag</p>
          </div>
          <div>
            <p class="font-semibold text-kyst-mork">Melding</p>
            <p class="bg-kyst-beige rounded px-3 py-2 font-mono text-xs">GB &lt;båtnavn&gt;, &lt;ditt kystlag&gt;</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Regler og info -->
    <div class="bg-white rounded-lg shadow p-8 mb-10">
      <h2 class="text-xl font-heading font-bold mb-4">Viktig informasjon</h2>
      <ul class="text-kyst-graa text-sm space-y-2">
        <li>&#9875; Gjestebryggen er prioritert for medlemmer av kystlag tilknyttet Forbundet Kysten og leietakere av selskapslokalene</li>
        <li>&#9875; Ledig område er merket med hvite striper — alle andre plasser er opptatt</li>
        <li>&#9875; Maks ett døgns opphold (andre avtaler krever forhåndsgodkjenning)</li>
        <li>&#9875; Strøm er tilgjengelig og inkludert i prisen</li>
      </ul>
    </div>

    <!-- Kontakt -->
    <div class="bg-kyst-blaa/10 rounded-lg p-8">
      <h2 class="text-xl font-heading font-bold mb-2">Kontakt</h2>
      <div class="text-kyst-graa text-sm space-y-1">
        <p><strong>Adresse:</strong> Framnesveien 5, 3222 Sandefjord</p>
        <p><strong>Telefon:</strong> <a href="tel:45816286" class="text-kyst-blaa hover:underline">458 16 286</a></p>
        <p><strong>E-post:</strong> <a href="mailto:post@gokstadkystlag.no" class="text-kyst-blaa hover:underline">post@gokstadkystlag.no</a></p>
      </div>
    </div>
  </div>
</Layout>
