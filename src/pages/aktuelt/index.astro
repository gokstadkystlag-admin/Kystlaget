---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const artikler = (await getCollection("artikler"))
  .sort((a, b) => b.data.dato.getTime() - a.data.dato.getTime());
---

<Layout tittel="Aktuelt" beskrivelse="Nyheter fra Gokstad Kystlag i Sandefjord, fra kystlaget, arbeidslagene og bladet Kystvakt.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-heading font-bold mb-8">Aktuelt</h1>

    {artikler.length > 0 ? (
      <div class="space-y-6">
        {artikler.map((art) => (
          <a href={`/aktuelt/${art.id}`} class="block bg-white rounded-lg shadow hover:shadow-md transition overflow-hidden">
            {art.data.bilde && (
              <img src={art.data.bilde} alt={art.data.tittel} class="w-full h-48 object-cover" loading="lazy" />
            )}
            <div class="p-6">
              <time class="text-sm text-kyst-lys-blaa">
                {art.data.dato.toLocaleDateString("nb-NO", { day: "numeric", month: "long", year: "numeric" })}
              </time>
              <h2 class="text-xl font-heading font-bold mt-1">{art.data.tittel}</h2>
              <p class="text-gray-600 mt-2">{art.data.beskrivelse}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-gray-600">Ingen artikler ennå. Følg med!</p>
    )}
  </div>
</Layout>
