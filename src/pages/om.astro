---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";
import { avsnitt } from "../lib/tekst";

const side = (await getEntry("sider", "om"))!.data;
---

<Layout tittel="Om oss" beskrivelse="Gokstad Kystlag ble stiftet i 1990 og har rundt 400 medlemmer fordelt på 11 arbeidslag. Vi tar vare på kystkultur og tradisjonelle fartøy i Sandefjord.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-heading font-bold mb-8">{side.tittel}</h1>

    <img src={side.bilde} alt="Gokstad Kystlag ved havnen" class="w-full h-72 object-cover rounded-lg mb-8" />

    <div class="text-kyst-graa space-y-4 mb-12">
      {avsnitt(side.intro).map((p) => <p>{p}</p>)}
    </div>

    <h2 class="text-2xl font-heading font-bold mb-6">{side.bygninger_tittel}</h2>
    <div class="grid md:grid-cols-2 gap-6 mb-12">
      {side.bygninger.map((b: { tittel: string; tekst: string }) => (
        <div class="bg-white rounded-lg shadow p-6">
          <h3 class="font-heading font-bold text-lg mb-2">{b.tittel}</h3>
          <p class="text-kyst-graa text-sm">{b.tekst}</p>
        </div>
      ))}
    </div>

    <!-- Bli medlem -->
    <section id="medlem" class="mb-10">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <img src={side.medlem.bilde} alt="Båthavn ved Gokstad Kystlag" loading="lazy" class="w-full h-64 object-cover rounded-lg" />
        <div class="bg-kyst-blaa text-white rounded-lg p-8">
          <h2 class="text-2xl font-heading font-bold mb-4">{side.medlem.tittel}</h2>
          <p class="text-gray-200 mb-4">
            {side.medlem.tekst}
          </p>
          <h3 class="font-semibold mb-2">{side.medlem.fordeler_tittel}</h3>
          <ul class="list-disc list-inside text-gray-200 space-y-1 mb-6 text-sm">
            {side.medlem.fordeler.map((f: string) => <li>{f}</li>)}
          </ul>
          <a href="https://forbundetkysten.portal.styreweb.com/arrangement/ArrangementSession?ID=Innmelding" target="_blank" rel="noopener" class="bg-kyst-gul text-kyst-mork px-6 py-3 rounded-md font-bold hover:bg-amber-400 transition-colors inline-block">
            {side.medlem.knapp_tekst}
          </a>
        </div>
      </div>
    </section>

    <!-- Kontakt oss -->
    <section class="bg-kyst-blaa/10 rounded-lg p-8">
      <h2 class="text-2xl font-heading font-bold mb-2">{side.kontakt.tittel}</h2>
      <p class="text-kyst-graa mb-4">
        {side.kontakt.tekst}
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/kontakt" class="bg-kyst-blaa text-white px-5 py-2.5 rounded-md font-bold hover:bg-kyst-lys-blaa transition-colors text-sm">
          Send melding
        </a>
        <a href={`mailto:${side.kontakt.epost}`} class="border-2 border-kyst-blaa text-kyst-blaa px-5 py-2.5 rounded-md font-semibold hover:bg-kyst-blaa hover:text-white transition-colors text-sm">
          {side.kontakt.epost}
        </a>
        <a href={`tel:${side.kontakt.telefon.replace(/\s/g, "")}`} class="border-2 border-kyst-blaa text-kyst-blaa px-5 py-2.5 rounded-md font-semibold hover:bg-kyst-blaa hover:text-white transition-colors text-sm">
          {side.kontakt.telefon}
        </a>
      </div>
      <p class="text-kyst-graa text-sm mt-4">
        {side.kontakt.adresse}
      </p>
    </section>
  </div>
</Layout>
