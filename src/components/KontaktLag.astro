---
interface Props {
  lag: string;
}

const { lag } = Astro.props;
---

<div class="mt-10 bg-kyst-blaa text-white rounded-lg p-8">
  <h2 class="font-heading font-bold text-xl mb-2">Interessert i {lag}?</h2>
  <p class="text-gray-200 mb-4 text-sm">
    Ta kontakt med styret, så hjelper vi deg videre. Enten du vil bli med, har spørsmål eller bare vil vite mer.
  </p>
  <div class="flex flex-wrap gap-4">
    <a href={`mailto:post@gokstadkystlag.no?subject=${encodeURIComponent('Jeg vil gjerne komme i kontakt angående ' + lag)}`}
      class="bg-kyst-gul text-kyst-mork px-5 py-2.5 rounded-md font-bold hover:bg-amber-400 transition-colors text-sm">
      Send oss en e-post
    </a>
    <a href="tel:45816286"
      class="border-2 border-white px-5 py-2.5 rounded-md font-semibold hover:bg-white/10 transition-colors text-sm">
      Ring oss på 458 16 286
    </a>
  </div>
  <p class="text-gray-300 text-xs mt-4">
    Åpnes ikke e-postprogrammet? Send til post@gokstadkystlag.no
  </p>
</div>
