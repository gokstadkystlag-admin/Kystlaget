---
interface Props {
  lag: string;
}

const { lag } = Astro.props;
---

<div class="mt-10 bg-kyst-blaa text-white rounded-lg p-8">
  <h2 class="font-heading font-bold text-xl mb-2">Interessert i {lag}?</h2>
  <p class="text-gray-200 mb-4 text-sm">
    Ta kontakt med styret så hjelper vi deg videre — enten du vil bli med, har spørsmål eller bare vil vite mer.
  </p>
  <div class="flex flex-wrap gap-4">
    <a href={`/kontakt?emne=${encodeURIComponent('Bli med i ' + lag)}`}
      class="bg-kyst-gul text-kyst-mork px-5 py-2.5 rounded font-semibold hover:opacity-90 transition text-sm">
      Send melding
    </a>
    <a href="mailto:post@gokstadkystlag.no"
      class="border border-white px-5 py-2.5 rounded hover:bg-white/10 transition text-sm">
      post@gokstadkystlag.no
    </a>
    <a href="tel:45816286"
      class="border border-white px-5 py-2.5 rounded hover:bg-white/10 transition text-sm">
      458 16 286
    </a>
  </div>
</div>
